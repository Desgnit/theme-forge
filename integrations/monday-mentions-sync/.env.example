# Monday.com personal API token (admin picture > Developers > My access tokens)
MONDAY_API_TOKEN=

# Public HTTPS URL that Monday will call when a comment is posted.
# Point a Synology reverse-proxy entry at this container (port 8712), e.g.:
#   https://monday-sync.ricoman.com/monday-webhook
PUBLIC_WEBHOOK_URL=

# Endpoint on the tasks app that creates a task (see README for the contract), e.g.:
#   https://tasks.ricoman.com/api/integrations/tasks
TASKS_API_URL=

# Optional bearer token the tasks app requires
TASKS_API_TOKEN=

# Optional shared secret appended to the webhook URL (?secret=...) so only
# Monday-registered calls are accepted
WEBHOOK_SECRET=

# How often to re-scan Monday for new boards (minutes)
RESYNC_INTERVAL_MINUTES=360
